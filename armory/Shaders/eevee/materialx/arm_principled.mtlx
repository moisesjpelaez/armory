<?xml version="1.0"?>
<materialx version="1.39">
  <!--
    OpenPBR surface whose inputs come from a Principled BSDF's values. The
    nodedef inputs are the shader's public interface, so they stay uniforms
    with a reduced shader interface and each material sets its own values.
    Mapping follows Blender's own MaterialX export of the Principled BSDF
    (subsurface and transmission colours follow the base colour).
  -->
  <nodedef name="ND_arm_principled" node="arm_principled" nodegroup="pbr">
    <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
    <input name="base_metalness" type="float" value="0.0" />
    <input name="specular_roughness" type="float" value="0.5" />
    <input name="specular_ior" type="float" value="1.5" />
    <input name="specular_weight" type="float" value="1.0" />
    <input name="specular_color" type="color3" value="1, 1, 1" />
    <input name="coat_weight" type="float" value="0.0" />
    <input name="coat_roughness" type="float" value="0.03" />
    <input name="coat_ior" type="float" value="1.5" />
    <input name="coat_color" type="color3" value="1, 1, 1" />
    <input name="fuzz_weight" type="float" value="0.0" />
    <input name="fuzz_roughness" type="float" value="0.5" />
    <input name="fuzz_color" type="color3" value="1, 1, 1" />
    <input name="emission_color" type="color3" value="1, 1, 1" />
    <input name="emission_luminance" type="float" value="0.0" />
    <input name="geometry_opacity" type="float" value="1.0" />
    <output name="out" type="surfaceshader" />
  </nodedef>

  <nodegraph name="NG_arm_principled" nodedef="ND_arm_principled">
    <open_pbr_surface name="surface" type="surfaceshader">
      <input name="base_color" type="color3" interfacename="base_color" />
      <input name="base_metalness" type="float" interfacename="base_metalness" />
      <input name="specular_roughness" type="float" interfacename="specular_roughness" />
      <input name="specular_ior" type="float" interfacename="specular_ior" />
      <input name="specular_weight" type="float" interfacename="specular_weight" />
      <input name="specular_color" type="color3" interfacename="specular_color" />
      <input name="coat_weight" type="float" interfacename="coat_weight" />
      <input name="coat_roughness" type="float" interfacename="coat_roughness" />
      <input name="coat_ior" type="float" interfacename="coat_ior" />
      <input name="coat_color" type="color3" interfacename="coat_color" />
      <input name="fuzz_weight" type="float" interfacename="fuzz_weight" />
      <input name="fuzz_roughness" type="float" interfacename="fuzz_roughness" />
      <input name="fuzz_color" type="color3" interfacename="fuzz_color" />
      <input name="emission_color" type="color3" interfacename="emission_color" />
      <input name="emission_luminance" type="float" interfacename="emission_luminance" />
      <input name="geometry_opacity" type="float" interfacename="geometry_opacity" />
      <input name="subsurface_color" type="color3" interfacename="base_color" />
      <input name="transmission_color" type="color3" interfacename="base_color" />
    </open_pbr_surface>
    <output name="out" type="surfaceshader" nodename="surface" />
  </nodegraph>

  <!-- The material the shader is generated for. Inputs are set on the instance
       so the reduced interface keeps them as uniforms. -->
  <arm_principled name="arm_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
    <input name="base_metalness" type="float" value="0.0" />
    <input name="specular_roughness" type="float" value="0.5" />
    <input name="specular_ior" type="float" value="1.5" />
    <input name="specular_weight" type="float" value="1.0" />
    <input name="specular_color" type="color3" value="1, 1, 1" />
    <input name="coat_weight" type="float" value="0.0" />
    <input name="coat_roughness" type="float" value="0.03" />
    <input name="coat_ior" type="float" value="1.5" />
    <input name="coat_color" type="color3" value="1, 1, 1" />
    <input name="fuzz_weight" type="float" value="0.0" />
    <input name="fuzz_roughness" type="float" value="0.5" />
    <input name="fuzz_color" type="color3" value="1, 1, 1" />
    <input name="emission_color" type="color3" value="1, 1, 1" />
    <input name="emission_luminance" type="float" value="0.0" />
    <input name="geometry_opacity" type="float" value="1.0" />
  </arm_principled>
  <surfacematerial name="arm_principled_material" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="arm_surface" />
  </surfacematerial>
</materialx>
