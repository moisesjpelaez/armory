<?xml version="1.0"?>
<materialx version="1.39">
  <!--
    Blender lights for MaterialX's generated light loop.

    MaterialX only builds the LightData struct for implementations registered in
    C++ by name (IM_point_light_genglsl, IM_directional_light_genglsl,
    IM_spot_light_genglsl). So this library replaces MaterialX's own "lights"
    library and reuses the point_light slot for one universal Blender light;
    `kind` picks the Blender type: 0 = sun, 1 = point, 2 = spot.

    Inputs keep Blender's units: sun strength in W/m2, point/spot power in W,
    spot cone as Blender's spot_size (full angle, radians) and spot_blend (0..1).
    The returned intensity is irradiance at normal incidence (W/m2), which is
    what MaterialX's BSDFs multiply by (they include N.L and 1/pi themselves).
  -->
  <nodedef name="ND_point_light" node="point_light" nodegroup="light">
    <input name="kind" type="integer" value="1" />
    <input name="position" type="vector3" value="0, 0, 0" />
    <input name="direction" type="vector3" value="0, 0, -1" />
    <input name="color" type="color3" value="1, 1, 1" />
    <input name="energy" type="float" value="1000.0" />
    <input name="spot_size" type="float" value="0.785398" />
    <input name="spot_blend" type="float" value="0.15" />
    <output name="out" type="lightshader" />
  </nodedef>

  <implementation name="IM_point_light_genglsl" nodedef="ND_point_light" file="arm_light.glsl" function="arm_light" target="genglsl" />

  <!-- One instance registers the type; the LightData struct follows its inputs. -->
  <point_light name="blender_light" type="lightshader">
    <input name="kind" type="integer" value="1" />
    <input name="position" type="vector3" value="0, 0, 0" />
    <input name="direction" type="vector3" value="0, 0, -1" />
    <input name="color" type="color3" value="1, 1, 1" />
    <input name="energy" type="float" value="1000.0" />
    <input name="spot_size" type="float" value="0.785398" />
    <input name="spot_blend" type="float" value="0.15" />
  </point_light>
</materialx>
