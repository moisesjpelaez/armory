<?xml version="1.0"?>
<materialx version="1.39">
  <!--
    Material pass of the Eevee renderer: the surface values a material's node
    graph produces, written to the material images (G-buffer) that the lighting
    pass reads. mx_graph replaces a material's open_pbr_surface by this node, so
    input names and defaults follow ND_open_pbr_surface_surfaceshader.

    `position` is the world position, for the triangle's own normal (shadows).
    The output is a plain color4, unused: as a surfaceshader, MaterialX would add
    its whole lighting library to the shader.
  -->
  <nodedef name="ND_arm_gbuffer" node="arm_gbuffer" nodegroup="pbr">
    <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
    <input name="base_metalness" type="float" value="0.0" />
    <input name="specular_weight" type="float" value="1.0" />
    <input name="specular_color" type="color3" value="1, 1, 1" />
    <input name="specular_roughness" type="float" value="0.3" />
    <input name="specular_ior" type="float" value="1.5" />
    <input name="emission_luminance" type="float" value="0.0" />
    <input name="emission_color" type="color3" value="1, 1, 1" />
    <input name="geometry_normal" type="vector3" defaultgeomprop="Nworld" />
    <input name="position" type="vector3" defaultgeomprop="Pworld" />
    <output name="out" type="color4" />
  </nodedef>

  <implementation name="IM_arm_gbuffer_genglsl" nodedef="ND_arm_gbuffer" file="arm_gbuffer.glsl" function="arm_gbuffer" target="genglsl" />
</materialx>
