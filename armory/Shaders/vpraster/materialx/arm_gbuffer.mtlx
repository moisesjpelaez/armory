<?xml version="1.0"?>
<materialx version="1.39">
  <!--
    Material pass of the Viewport renderer: nodes that take the surface values a
    material's node graph produces and write them to the material images (G-buffer)
    that the lighting pass reads. mx_graph.py puts one of these nodes in place of a
    material's exported surface, so the input names and defaults follow
    ND_open_pbr_surface_surfaceshader. The GLSL is in arm_gbuffer.glsl.

    arm_gbuffer: opaque materials.

    arm_gbuffer_cutout: materials with alpha (Eevee's Dithered render method). It
    drops pixels below a threshold that changes per pixel and frame. Temporal
    anti-aliasing averages the frames into the partial coverage.

    arm_gbuffer_blended: Eevee's Blended render method. The shader lights the values
    itself and blends the result by the opacity (materials.py).

    `position` is the world position, used for the triangle's own normal (shadows).
    The output is a plain color4 that nothing reads. As a surfaceshader output,
    MaterialX would add its whole lighting library to the shader.
  -->
  <nodedef name="ND_arm_gbuffer" node="arm_gbuffer" nodegroup="pbr">
    <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
    <input name="base_metalness" type="float" value="0.0" />
    <input name="specular_weight" type="float" value="1.0" />
    <input name="specular_color" type="color3" value="1, 1, 1" />
    <input name="specular_roughness" type="float" value="0.3" />
    <input name="specular_ior" type="float" value="1.5" />
    <input name="emission_luminance" type="float" value="0.0" />
    <input name="emission_color" type="color3" value="1, 1, 1" />
    <input name="geometry_normal" type="vector3" defaultgeomprop="Nworld" />
    <input name="position" type="vector3" defaultgeomprop="Pworld" />
    <output name="out" type="color4" />
  </nodedef>

  <nodedef name="ND_arm_gbuffer_cutout" node="arm_gbuffer_cutout" nodegroup="pbr">
    <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
    <input name="base_metalness" type="float" value="0.0" />
    <input name="specular_weight" type="float" value="1.0" />
    <input name="specular_color" type="color3" value="1, 1, 1" />
    <input name="specular_roughness" type="float" value="0.3" />
    <input name="specular_ior" type="float" value="1.5" />
    <input name="emission_luminance" type="float" value="0.0" />
    <input name="emission_color" type="color3" value="1, 1, 1" />
    <input name="geometry_normal" type="vector3" defaultgeomprop="Nworld" />
    <input name="position" type="vector3" defaultgeomprop="Pworld" />
    <input name="opacity" type="float" value="1.0" />
    <output name="out" type="color4" />
  </nodedef>

  <nodedef name="ND_arm_gbuffer_blended" node="arm_gbuffer_blended" nodegroup="pbr">
    <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
    <input name="base_metalness" type="float" value="0.0" />
    <input name="specular_weight" type="float" value="1.0" />
    <input name="specular_color" type="color3" value="1, 1, 1" />
    <input name="specular_roughness" type="float" value="0.3" />
    <input name="specular_ior" type="float" value="1.5" />
    <input name="emission_luminance" type="float" value="0.0" />
    <input name="emission_color" type="color3" value="1, 1, 1" />
    <input name="geometry_normal" type="vector3" defaultgeomprop="Nworld" />
    <input name="position" type="vector3" defaultgeomprop="Pworld" />
    <input name="opacity" type="float" value="1.0" />
    <output name="out" type="color4" />
  </nodedef>

  <implementation name="IM_arm_gbuffer_genglsl" nodedef="ND_arm_gbuffer" file="arm_gbuffer.glsl" function="arm_gbuffer" target="genglsl" />
  <implementation name="IM_arm_gbuffer_cutout_genglsl" nodedef="ND_arm_gbuffer_cutout" file="arm_gbuffer.glsl" function="arm_gbuffer_cutout" target="genglsl" />
  <implementation name="IM_arm_gbuffer_blended_genglsl" nodedef="ND_arm_gbuffer_blended" file="arm_gbuffer.glsl" function="arm_gbuffer_blended" target="genglsl" />
</materialx>
